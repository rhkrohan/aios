[Desktop Entry]
Type=Application
Name=Files
GenericName=File Manager
Comment=Your files, with what's inside each folder at a glance
Exec=sios-files %U
Icon=system-file-manager
Terminal=false
Categories=Qt;KDE;System;FileManager;Core;
MimeType=inode/directory;
StartupWMClass=sios-files
Keywords=files;folders;explorer;finder;

[Icon Theme]
Name=SIOS
Comment=SIOS: blue folders in the sidebar; everything else is Breeze (apps keep their own icons)
Inherits=breeze,hicolor
Directories=places/22

# The preview's blue folders in the Files sidebar (small sizes). Breeze draws
# these as grey outlines below 32px; these are Breeze's own colour folders
# (LGPL-3.0, KDE breeze-icons), copied into places/22.
[places/22]
Size=22
MinSize=16
MaxSize=24
Type=Scalable
Context=Places

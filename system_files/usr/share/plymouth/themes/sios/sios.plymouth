# The SIOS boot screen, like the preview's (build_concept_html/src/components/
# shell/Power.tsx BootScreen): black, the string orb at work, SIOS, a light
# blue to violet bar that follows the real boot progress, and a short line
# under it. Pictures drawn from the preview's code by ui/render-plymouth.mjs.
[Plymouth Theme]
Name=SIOS
Description=SIOS boot screen
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/sios
ScriptFile=/usr/share/plymouth/themes/sios/sios.script

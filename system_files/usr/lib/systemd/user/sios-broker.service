# SIOS broker (capd): every AI action is checked here (D4, D20, D31).
# A user service for now, so its system tools can reach this session's desktop;
# a system service with its own account later. Callers are known by their
# program, not by secret files (SIOS_IDENTITY=peer, D32).
[Unit]
Description=SIOS broker: checks every AI action
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# State is private (0700) in the home; AIs can never name a hidden folder.
# AIs work in the real home (owner's choice 2026-10-14, part of M9); hidden
# folders (.ssh, .local/share/sios, keys) are never reachable (fsguard).
# SIOS_ADAPTERS=real: system tools change the real desktop (M6), not a preview
Environment=SIOS_STATE=%h/.local/share/sios SIOS_ROOT=%h SIOS_RUNTIME=%t/sios SIOS_IDENTITY=peer SIOS_ADAPTERS=real
ExecStart=/usr/bin/capd serve
RuntimeDirectory=sios
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
NoNewPrivileges=yes
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target

# SIOS brain (brain-d): plans requests and runs them through the broker (D3, D12).
[Unit]
Description=SIOS brain: plans what you ask and runs it through the broker
Requires=sios-broker.service
# After the session too, like the broker: otherwise the session target, which
# orders itself after the services it starts, waits for brain-d, brain-d waits
# for the broker, and the broker waits for the session (a cycle; systemd then
# drops brain-d's start, seen on the image 2026-10-14)
After=sios-broker.service graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=SIOS_STATE=%h/.local/share/sios SIOS_ROOT=%h/SIOS-test SIOS_RUNTIME=%t/sios SIOS_IDENTITY=peer
ExecStart=/usr/bin/brain-d serve
RuntimeDirectory=sios
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
NoNewPrivileges=yes
# brain-d never talks to the internet: model calls go through the broker (D33)
RestrictAddressFamilies=AF_UNIX
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
